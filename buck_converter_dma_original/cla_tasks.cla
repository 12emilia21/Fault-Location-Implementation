void derivatives(void){
    dio_smpl_cla[0] = (io_smpl_cla[1] - io_smpl_cla[0]) / TSMPL;
    dio_smpl_cla[1] = (io_smpl_cla[2] - io_smpl_cla[0]) / (2.0f*TSMPL);

    for(i=2;(uint32_t)i<(uint32_t)(BUFF_SAMPLES-1);i++) {        
        dio_smpl_cla[i] = (-io_smpl_cla[i+2]   + 8*io_smpl_cla[i+1] - 8*io_smpl_cla[i-1] + io_smpl_cla[i-2]) / (12.0f*TSMPL);
        if(i == BUFF_SAMPLES-2){
            dio_smpl_cla[i]   = (io_smpl_cla[i+1] - io_smpl_cla[i-1]) / (2.0f*TSMPL);
            dio_smpl_cla[i+1] = (io_smpl_cla[i+1] - io_smpl_cla[i]) / TSMPL;
        }
    }
    return; 
}

void partial_norms (void){
    /*
    if (s_count == 0) {
        n1_partial = 0.0;
        n2_partial = 0.0;
    }

    n1_partial += (io_smpl_cla[2*s_count]*io_smpl_cla[2*s_count])   + (io_smpl_cla[2*s_count+1]*io_smpl_cla[2*s_count+1]);
    n2_partial += (dio_smpl_cla[2*s_count]*dio_smpl_cla[2*s_count]) + (dio_smpl_cla[2*s_count+1]*dio_smpl_cla[2*s_count+1]);
    */
    n1_partial = 0.0;
    n2_partial = 0.0;
   
    for(i=0;(uint32_t)i<(uint32_t)BUFF_SAMPLES;i++) {
        n1_partial += (io_smpl_cla[i]*io_smpl_cla[i]);
        n2_partial += (dio_smpl_cla[i]*dio_smpl_cla[i]);
    }

    return;
}

void pivot (void){
    if(n2_partial > n1_partial){
        piv0  = 1;
        piv1  = 0;
        col0 = (float*)dio_smpl_cla;
        col1 = (float*) io_smpl_cla;
    }
    else {
        piv0 = 0;
        piv1 = 1;
        col0 = (float*) io_smpl_cla;
        col1 = (float*)dio_smpl_cla;
    }

    return;
}

// Utilizo temporalmente el acceso directo considerndo que n2_partial siempre es mayor que n1_partial
void hh1 (void){

    alpha = 0.0;
    beta  = 0.0; 
    vv    = 0.0;
    dot   = 0.0;
    dot1  = 0.0;

    for(i=0;(uint32_t)i<(uint32_t)BUFF_SAMPLES;i++) {
        alpha += dio_smpl_cla[i]*dio_smpl_cla[i];
        v_h[i] = dio_smpl_cla[i]; 

        if(i>0){
            vv   += v_h[i]*v_h[i];     
            dot  += v_h[i]*io_smpl_cla[i];
            dot1 += v_h[i]*vo_smpl_cla[i]; 
        }
    }
    
    alpha = CLAsqrt_inline(alpha);

    if(dio_smpl_cla[0] > 0)
        alpha = -alpha;

    v_h[0] -= alpha;

    vv   += v_h[0]*v_h[0];
    dot  += v_h[0]*io_smpl_cla[0];
    dot1 += v_h[0]*vo_smpl_cla[0];
    beta = CLAdiv_inline(2.0f,vv);

    for(i=0;(uint32_t)i<(uint32_t)BUFF_SAMPLES;i++) {        
        io_smpl_cla[i] -= beta * v_h[i] * dot;
        vo_smpl_cla[i] -= beta * v_h[i] * dot1;   
    }

    return;
}

void hh2 (void) {

    alpha2 = 0.0;
    beta2  = 0.0; 
    v2v2   = 0.0;
    dot2   = 0.0;

    for(i=0;(uint32_t)i<(uint32_t)BUFF_SAMPLES;i++) {
        if(i>0) {
            alpha2 += (io_smpl_cla[i]*io_smpl_cla[i]); 
        }  
            
        if(i < (BUFF_SAMPLES-1)){
            v2[i] = io_smpl_cla[i+1];
            v2v2 += v2[i]*v2[i];
            dot2 += v2[i]*vo_smpl_cla[i+1];
        }
    }

    alpha2 = CLAsqrt_inline(alpha2);

    if(io_smpl_cla[1] > 0)
        alpha2 = -alpha2;

    v2[0] -= alpha2;

    v2v2 += v2[0]*v2[0];
    dot2 += v2[0]*vo_smpl_cla[1];

    beta2 = CLAdiv_inline(2.0f,v2v2);

    for(i=0;i<(BUFF_SAMPLES-1);i++)
        vo_smpl_cla[i+1] -= beta2*v2[i]*dot2;

    return;
}


void back_subs (void){
    R_err = 0.0;
    L_err = 0.0; 
    R_out = 0.0;
    L_out = 0.0;

    sol[0]     = 0.0;
    sol[1]     = 0.0;

    sol[piv1] = CLAdiv_inline(vo_smpl_cla[1],alpha2);
    sol[piv0] = CLAdiv_inline((vo_smpl_cla[0] - io_smpl_cla[0]*sol[piv1]),alpha); 

    R_out = sol[0];
    L_out = sol[1];

    R_err = fabsf((sol[0]-5.8667f)/5.8667f)*100.0f;
    L_err = fabsf((sol[1]-0.00012698f)/0.00012698f)*100.0f;
    //R_err = R_out-REAL_R_FAULT;
    //L_err = fabsf(CLAdiv_inline((L_out-REAL_L_FAULT),REAL_L_FAULT))*100.0f;

    return;
}

__attribute__((interrupt)) void Cla1Task2(void)
{ 
}

__attribute__((interrupt)) void Cla1Task1(void)
{ 
    if (s_count<N_COMPUTE){
        vo_smpl_cla[2*s_count]   = vo_sample_test[0]; 
        vo_smpl_cla[2*s_count+1] = vo_sample_test[1]; 
        io_smpl_cla[2*s_count]   = io_sample_test[0]; 
        io_smpl_cla[2*s_count+1] = io_sample_test[1]; 
        
        if (s_count==(N_COMPUTE-1)){
            derivatives();
            partial_norms();
            pivot();
            hh1();
            hh2();
            back_subs();
        }
            
        /*
        if (s_count==(N_COMPUTE-1)){
            pivot();
            hh1();
            hh2();
            back_subs();
        }
        */
         
        GPIO_togglePin(CLA_test);
    }
}
