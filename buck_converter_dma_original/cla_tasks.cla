volatile uint16_t i;

// Sample buffers
float vo_smpl_cla[BUFF_SAMPLES]; 
float io_smpl_cla[BUFF_SAMPLES]; 
float dio_smpl_cla[BUFF_SAMPLES];
float v_h[BUFF_SAMPLES]; 
float v2[BUFF_SAMPLES];

// Norms calculations
float n1_partial;
float n2_partial;

// Pivoting
uint16_t piv0;
uint16_t piv1;
float *col0;
float *col1;

// Householder transformations
volatile float alpha;
volatile float beta;
volatile float vv;
volatile float dot;
volatile float dot1;

volatile float alpha2;
volatile float beta2; 
volatile float v2v2;
volatile float dot2;

float sol[2];

// Saturation considerations
volatile int nsat_smpl;       // Count consecutive non-saturated samples
volatile int nsat_smpl_prev;  // To detect begining/end of valid data batches
volatile int ef_index;        // Index of effective samples

// Derivatives calculation as they arrive from 4 in 4
