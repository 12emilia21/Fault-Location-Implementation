__attribute__((interrupt)) void Cla1Task2(void)
{ 
}

__attribute__((interrupt)) void Cla1Task1(void)
{ 
    if (s_count<N_COMPUTE){
        vo_smpl_cla[2*s_count]   = vo_sample_test[0]; 
        vo_smpl_cla[2*s_count+1] = vo_sample_test[1]; 
        //io_smpl_cla[2*s_count]   = io_sample_test[0]; 
        //io_smpl_cla[2*s_count+1] = io_sample_test[1]; 
        i_mtrx[0][2*s_count]     = io_sample_test[0]; 
        i_mtrx[0][2*s_count+1]   = io_sample_test[1]; 
        i_mtrx[1][2*s_count]     = 0; 
        i_mtrx[1][2*s_count+1]   = 0; 
        derivatives();
        partial_norms();    
        
         if (s_count==(N_COMPUTE-1)){
            pivot();
            hh1();
            hh2();
            //back_subs();
        }
        GPIO_togglePin(CLA_test);
    }
}
