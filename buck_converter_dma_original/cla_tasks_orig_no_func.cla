float vo_smpl_cla[BUFF_SAMPLES]; 
//float io_smpl_cla[BUFF_SAMPLES]; 
//float dio_smpl_cla[BUFF_SAMPLES];
float i_mtrx[2][BUFF_SAMPLES]; 
float v_h[BUFF_SAMPLES]; 
float v2[BUFF_SAMPLES];

volatile float n1_partial;
volatile float n2_partial;
volatile uint16_t piv0;
volatile uint16_t piv1;
//volatile float *col0;
//volatile float *col1;

volatile float alpha;
volatile float beta;
volatile float vv;
volatile float dot;
volatile float dot1;

volatile float alpha2;
volatile float beta2; 
volatile float v2v2;
volatile float dot2;

volatile uint16_t i;

//float R11;
//float R12;
//float R22;
//float x2;
//float x1;
float sol[2];


void derivatives (void){
    if(s_count == 0){
        i_mtrx[1][0] = (i_mtrx[0][1] - i_mtrx[0][0]) / TSMPL;
        //dio_smpl_cla[0] = (io_smpl_cla[1] - io_smpl_cla[0]) / TSMPL;
    }
    else {
        i_mtrx[1][2*s_count-1] = (i_mtrx[0][2*s_count]   - i_mtrx[0][2*s_count-2]) / (2.0f*TSMPL);
        i_mtrx[1][2*s_count]   = (i_mtrx[0][2*s_count+1] - i_mtrx[0][2*s_count-1]) / (2.0f*TSMPL);
        //dio_smpl_cla[2*s_count-1] = (io_smpl_cla[2*s_count]   - io_smpl_cla[2*s_count-2]) / (2.0f*TSMPL);
        //dio_smpl_cla[2*s_count]   = (io_smpl_cla[2*s_count+1] - io_smpl_cla[2*s_count-1]) / (2.0f*TSMPL);
        
        if(s_count == N_COMPUTE-1){
            i_mtrx[1][2*s_count+1] = (i_mtrx[0][2*s_count+1] - i_mtrx[0][2*s_count]) / TSMPL;
            //dio_smpl_cla[s_count] = (io_smpl_cla[s_count] - io_smpl_cla[s_count-1]) / TSMPL;
        }
    }
    return;
}

void partial_norms (void){
    if (s_count == 0) {
        n1_partial = 0.0;
        n2_partial = 0.0;
        alpha      = 0.0;
        vv         = 0.0;
        dot        = 0.0;
        dot1       = 0.0;
        alpha2     = 0.0;
        v2v2       = 0.0;
        dot2       = 0.0;
        //R11        = 0.0;
        //R12        = 0.0;
        //R22        = 0.0;
        //x2         = 0.0;
        //x1         = 0.0;
        //piv0       = 0;
        //piv1       = 1;
        sol[0]     = 0.0;
        sol[1]     = 0.0;
    }

    n1_partial += (i_mtrx[0][2*s_count]*i_mtrx[0][2*s_count]) + (i_mtrx[0][2*s_count+1]*i_mtrx[0][2*s_count+1]);
    n2_partial += (i_mtrx[1][2*s_count]*i_mtrx[1][2*s_count]) + (i_mtrx[1][2*s_count+1]*i_mtrx[1][2*s_count+1]);
    alpha2 += (i_mtrx[1][i]*i_mtrx[1][i]); 
    
    return;
}

void pivot (void){
    if(n2_partial > n1_partial){
        piv0  = 1;
        piv1  = 0;
        alpha = n2_partial;
        //col0 = (float*)dio_smpl_cla;
        //col1 = (float*) io_smpl_cla;
    }
    else {
        piv0 = 0;
        piv1 = 1;
        alpha = n1_partial;
        //col0 = (float*) io_smpl_cla;
        //col1 = (float*)dio_smpl_cla;
    }
    return;
}

void hh1 (void){
    for(i=0;(uint32_t)i<(uint32_t)BUFF_SAMPLES;i++) {
        //alpha += col0[i]*col0[i];
       // alpha += (i_mtrx[piv0][i]*i_mtrx[piv0][i]);
        v_h[i] = i_mtrx[piv0][i]; // Originalment col0[i]. Termina copiando el mismo valor que tenia en la ubicacion de la matriz?

        if(i>0){
            vv   += v_h[i]*v_h[i]; // esto es = a alpha pero sin el primer indice? que termina siendo el mismo valor que el de la norma?
            dot  += v_h[i]*i_mtrx[piv1][i];
            dot1 += v_h[i]*vo_smpl_cla[i]; 
        }
    }
    
    alpha = CLAsqrt_inline(alpha);

    if(i_mtrx[piv0][0] > 0)
        alpha = -alpha;

    v_h[0] -= alpha;

    vv   += v_h[0]*v_h[0];
    dot  += v_h[0]*i_mtrx[piv1][0];
    dot1 += v_h[0]*vo_smpl_cla[0];

    beta = CLAdiv_inline(2.0f,vv);

    for(i=0;(uint32_t)i<(uint32_t)BUFF_SAMPLES;i++) {
        i_mtrx[piv1][i] -= beta * v_h[i] * dot;
        vo_smpl_cla[i]  -= beta * v_h[i] * dot1;   
    }

    return;
}

void hh2 (void) {
    for(i=0;(uint32_t)i<(uint32_t)BUFF_SAMPLES;i++) {
        if(i>0) {
            alpha2 += (i_mtrx[piv1][i]*i_mtrx[piv1][i]); 
            //alpha2 += (i_mtrx[piv1][i]*i_mtrx[piv1][i]); // esto sera mas conveniente utilizar el n_partial y restarle la primera muestra?
        }  
            
        if(i < (BUFF_SAMPLES-1)){
            v2[i] = i_mtrx[piv1][i+1];
            v2v2 += v2[i]*v2[i];
            dot2 += v2[i]*vo_smpl_cla[i+1];
        }
    }

    alpha2 = CLAsqrt_inline(alpha2);

    if(i_mtrx[piv1][1] > 0)
        alpha2 = -alpha2;

    v2[0] -= alpha2;

    v2v2 += v2[0]*v2[0];
    dot2 += v2[0]*vo_smpl_cla[1];

    beta2 = CLAdiv_inline(2.0f,v2v2);

    for(i=0;i<(BUFF_SAMPLES-1);i++)
        vo_smpl_cla[i+1] -= beta2*v2[i]*dot2;

    return;
}
