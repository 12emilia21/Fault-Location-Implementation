menuitem "Save simulation data";

hotmenu save_data()
{
    GEL_EnableFileOutput("C:\\ccs_debug\\buffer.csv", 0, 0);

    GEL_TextOut("VAR1\n");
    GEL_MemorySaveData(
        &dio_smpl_cla,
        1,
        72,
        "C:\\ccs_debug\\buffer.csv",
        16, 
        1
    );

    GEL_TextOut("VAR2\n");
    GEL_MemorySaveData(
        &io_smpl_cla,
        1,
        72,
        "C:\\ccs_debug\\buffer.csv",
        16, 
        1
    );

    GEL_TextOut("VAR2\n");
    GEL_MemorySaveData(
        &io_smpl_cla,
        1,
        72,
        "C:\\ccs_debug\\buffer.csv",
        16, 
        1
    );


}


